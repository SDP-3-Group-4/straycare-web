# Copy to .env and fill in your values
DATABASE_URL=postgresql://postgres:password@localhost:5432/straycare?schema=public

# NVIDIA NIM (Nemotron) AI configuration
NIM_API_KEY=
NIM_MODEL=nvidia/nemotron-3-nano-30b-a3b
NIM_RESCUE_MODEL=nvidia/nemotron-mini-4b-instruct
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_TIMEOUT_MS=60000

# AI auto-response on unanswered rescue posts
AI_RESPONSE_INTERVAL_MIN=10
AI_RESPONSE_WAIT_MIN=30

# Per-user chat rate limit (cost-abuse guardrail)
AI_RATE_LIMIT_MAX=10
AI_RATE_LIMIT_WINDOW_MIN=2

# Firebase Admin SDK (production-grade auth)
FIREBASE_PROJECT_ID=straycare-dev
FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/firebase-adminsdk-service-account.json
