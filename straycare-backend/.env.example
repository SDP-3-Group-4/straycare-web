# Copy this file to `.env` and fill in the values:
#   cp .env.example .env

# Overridden by docker-compose.yml - can stay as-is
DATABASE_URL=postgresql://postgres:password@postgres:5432/straycare?schema=public

# NVIDIA NIM - only needed if the AI Vet/auto-response features are enabled
NIM_API_KEY=replace-me
NIM_MODEL=nim/meta/llama-3.3-70b-instruct
NIM_RESCUE_MODEL=nim/meta/llama-3.3-70b-instruct
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_TIMEOUT_MS=120000

# AI auto-response on unanswered rescue posts
AI_RESPONSE_INTERVAL_MIN=10
AI_RESPONSE_WAIT_MIN=60

# Per-user chat rate limit (cost-abuse guardrail)
AI_RATE_LIMIT_MAX=10
AI_RATE_LIMIT_WINDOW_MIN=60

# Firebase Admin SDK - FIREBASE_PROJECT_ID is overridden by docker-compose.yml.
# FIREBASE_SERVICE_ACCOUNT_PATH points inside the container and is also
# overridden by docker-compose.yml. The real secret stays on disk at
# ./firebase-service-account.json (gitignored).
FIREBASE_PROJECT_ID=straycare-dev
FIREBASE_SERVICE_ACCOUNT_PATH=/app/service-account.json